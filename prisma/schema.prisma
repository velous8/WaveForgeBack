generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model downloads {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id       String   @db.Uuid
  token_hash     String   @unique
  download_count Int      @default(0)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  expires_at     DateTime @db.Timestamptz(6)
  orders         orders   @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model orders {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pack_id          String             @db.Uuid
  user_id          String             @db.Uuid
  status           order_status       @default(pending)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  paid_at          DateTime?          @db.Timestamptz(6)
  downloads        downloads[]
  packs            packs              @relation(fields: [pack_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users            users              @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment_webhooks payment_webhooks[]
}

model pack_previews {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pack_id    String   @db.Uuid
  title      String
  bpm        Int?
  key        String?
  style      String?
  file_key   String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  packs      packs    @relation(fields: [pack_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model packs {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String
  description   String?
  image_url     String?
  price         Int
  currency      currency_type   @default(RUB)
  file_key      String
  is_active     Boolean         @default(true)
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime        @default(now()) @db.Timestamptz(6)
  orders        orders[]
  pack_previews pack_previews[]
}

model payment_webhooks {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id     String    @db.Uuid
  event_type   String
  event_id     String
  payload      Json
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  processed_at DateTime? @db.Timestamptz(6)
  orders       orders    @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model users {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  email         String          @unique @db.Citext
  orders        orders[]
  verifications verifications[]
}

model verifications {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String              @db.Uuid
  code        String
  status      verification_status @default(pending)
  created_at  DateTime            @default(now()) @db.Timestamptz(6)
  expires_at  DateTime            @db.Timestamptz(6)
  counter_try Int                 @default(0)
  max_try     Int                 @default(5)
  users       users               @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

enum currency_type {
  RUB
}

enum order_status {
  pending
  paid
  cancelled
  expired
}

enum verification_status {
  pending
  varified
  expired
}
